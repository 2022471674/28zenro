# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class

# ---- 打包 / 发布产物 ----
build/
dist
release/

# ---- 运行输出与临时文件 ----
output/
*.log
*.bak

# ---- 本地诊断脚本与截图 ----
_xref_diag.py
_shot_settings.png

# ---- 开发期临时脚本与调试残留 ----
# 临时调试脚本（仅项目根目录的 _tmp* / _xref* 等，不误伤 __init__.py 与 _helpers 等包文件）
_tmp*.py
_tmp*.*
_xref*.py

# 永远不要忽略 Python 包文件（覆盖上面的下划线规则）
!__init__.py
!**/__init__.py
!**/_helpers.py
!**/_paths.py
*.sig.txt

# ---- MCP 中间产物 / 契约导出 ----
mcp/_*.txt
mcp/**/_*.txt
mcp/**/_chunks/

# ---- 文档草稿（发布物，不进代码库）----
docs/*_draft.md

# ---- 本地下载的壁纸 / 临时图片 ----
genshin_wallpaper*.jpg

# ---- 虚拟环境 ----
.venv/
venv/

# ---- 本地 AI 助手记忆 ----
.workbuddy-ai/
memory/

# ---- 运行时生成的数据库 / Payload 产物 ----
payload/payloads.db
payload/build/

# ---- 编辑器 / IDE ----
.vscode/
.idea/


# ---- 本地环境/配置（历史遗留，已废弃，勿提交） ----
.env
.env.*

